SUPABASE_URL=https://iwkeqytdmkaqcecyqlzc.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In (required)
# Use the Web application OAuth client ID from Google Cloud Console.
# This same Web client ID must be configured in Supabase:
#   Authentication → Providers → Google → Client IDs
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional — only needed for iOS native Google Sign-In
# GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# AI chatbot (Gemini) — leave empty to disable
GEMINI_API_KEY=

# Sticker picker (Giphy) — leave empty to disable
GIPHY_API_KEY=

# Optional TURN server for calls that can't connect directly (some mobile
# networks). Comma-separate several URLs. Leave TURN_URL empty to use STUN only.
# TURN_URL=turn:your.server:3478,turns:your.server:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
